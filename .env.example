MONGO_URL_SESSION=mongodb://mongo.example.com:27017/sme
MONGO_USER=sme
MONGO_PASS=replace-with-a-strong-password
MONGO_AUTH_SOURCE=admin

# Required only when the database is empty. Remove after the first administrator is created.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
INITIAL_ADMIN_EMAIL=admin@example.edu.vn
