PROJECT_NAME=sme

COOKIE_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
CORS_ORIGINS=https://app.mnngochoang.com
PARENT_PORTAL_SECRET=replace-with-the-shared-camera-portal-secret
WS_PORT=3013

VIETQR_BANK_CODE=ACB
VIETQR_ACCOUNT_NO=replace-with-bank-account
VIETQR_ACCOUNT_NAME=replace-with-account-name

